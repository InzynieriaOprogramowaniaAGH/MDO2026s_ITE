pipeline {
    agent any
    environment {
        NETWORK_NAME = "app-network-${BUILD_NUMBER}"
    }

    stages {
        stage('Build') {
            steps {
                dir('ITE/GCL3/IK424364/cw6/realworld-backend-spring') {
                    sh 'docker build -t realworld-app:latest .'
                }
            }
        }
        stage('API Tests') {
            steps {
                script {
                    sh "docker network create ${NETWORK_NAME}"
                    // Добавил --entrypoint sh, если вдруг есть проблемы с запуском, но тут оставляем как есть
                    sh "docker run -d --name app-container --network ${NETWORK_NAME} -e SERVER_ADDRESS=0.0.0.0 -e SERVER_PORT=8080 realworld-app:latest"

                    echo "Начинаю цикл проверки (режим отладки)..."
                    
                    // Цикл на 10 попыток (по 5 секунд каждая = 50 секунд)
                    def success = false
                    for (int i = 0; i < 10; i++) {
                        echo "Попытка #${i+1}: Проверяю запуск..."
                        
                        // Проверяем, жив ли вообще контейнер
                        def isRunning = sh(script: "docker inspect -f '{{.State.Running}}' app-container", returnStdout: true).trim()
                        if (isRunning != 'true') {
                            echo "!!! ОШИБКА: Контейнер упал. Вот его логи:"
                            sh 'docker logs app-container'
                            error "Контейнер app-container завершился с ошибкой."
                        }

                        // Проверяем доступность
                        def status = sh(script: "docker run --rm --network ${NETWORK_NAME} curlimages/curl:8.19.0 -s -o /dev/null -w '%{http_code}' http://app-container:8080/api/tags || echo 0", returnStdout: true).trim()
                        
                        if (status == '200') {
                            echo "Приложение доступно!"
                            success = true
                            break
                        } else {
                            echo "Приложение еще не готово (код ответа: ${status}). Читаю логи..."
                            sh 'docker logs app-container | tail -n 20' // выводим последние 20 строк логов
                        }
                        sleep 5
                    }

                    if (!success) {
                        echo "!!! ПРИЛОЖЕНИЕ НЕ ПОДНЯЛОСЬ. ПОЛНЫЕ ЛОГИ:"
                        sh 'docker logs app-container'
                        error "Не удалось дождаться запуска приложения."
                    }
                }
            }
            post {
                always {
                    sh 'docker stop app-container || true'
                    sh 'docker rm app-container || true'
                    sh "docker network rm ${NETWORK_NAME} || true"
                }
            }
        }
        stage('Deploy') {
            steps {
                script {
                    echo "Deploying to production environment..."
                    sh 'docker stop realworld-prod || true'
                    sh 'docker rm realworld-prod || true'
                    
                    sh 'docker run -d --name realworld-prod -p 8081:8080 realworld-app:latest'
                    
                    sleep 10
                    def smoke = sh(script: "curl -s -o /dev/null -w '%{http_code}' http://localhost:8081/api/tags", returnStdout: true).trim()
                    
                    if (smoke == '200') {
                        echo "Deployment udany. Aplikacja działa na porcie 8081."
                    } else {
                        error "Test nie przeszedł! Aplikacja nie wstała."
                    }
                }
            }
        }
        stage('Publish') {
            steps {
                script {
                    sh 'docker create --name temp-container realworld-app:latest'
                    sh 'docker cp temp-container:/app/app.jar ./realworld-app.jar'
                    sh 'docker rm temp-container'
                    archiveArtifacts artifacts: 'realworld-app.jar', fingerprint: true
                }
            }
        }
    }
    post {
        success {
            echo 'Sukces'
        }
        failure {
            echo 'Błąd'
        }
    }
}
