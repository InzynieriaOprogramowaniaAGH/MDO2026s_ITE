FROM node:22

WORKDIR /app

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/fastify/fastify.git .

RUN npm install

RUN echo "const fastify = require('fastify')({ logger: true }); \
          fastify.get('/', (req, reply) => { reply.send({ status: 'ok' }) }); \
          fastify.listen({ port: 3000, host: '0.0.0.0' });" > app.js

CMD ["node", "app.js"]