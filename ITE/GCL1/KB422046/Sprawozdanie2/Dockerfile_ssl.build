FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates openssl git build-essential autoconf automake libtool \
    pkg-config libpsl-dev libssl-dev zlib1g-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /repository
RUN git clone --depth 1 https://github.com/curl/curl.git

WORKDIR /repository/curl
RUN autoreconf -fi && ./configure --with-openssl=/usr --with-zlib && make -j"$(nproc)"