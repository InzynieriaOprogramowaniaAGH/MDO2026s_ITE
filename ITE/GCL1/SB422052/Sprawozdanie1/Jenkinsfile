pipeline {
    agent any
    stages {
        stage('Build: Budowanie obrazu') {
            steps {
                dir('ITE/GCL1/SB422052/Sprawozdanie1') {
                    sh 'docker build -t moj-express-lab5 .'
                }
            }
        }
        stage('Test: Uruchomienie testów') {
            steps {
                dir('ITE/GCL1/SB422052/Sprawozdanie1') {
                    
                    sh '''
                    cat <<EOF > Dockerfile.test
                    FROM node:18-alpine
                    WORKDIR /app
                    COPY . .
                    RUN npm install
                    CMD ["npm", "test"]
                    EOF
                    
                    docker build -t tester-lab5 -f Dockerfile.test .
                    docker run --rm tester-lab5
                    '''
                }
            }
        }
    }
}