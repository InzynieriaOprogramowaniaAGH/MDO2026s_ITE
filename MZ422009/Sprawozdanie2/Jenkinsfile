pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'pwd'
                sh 'ls -R'
            }
        }

        stage('Cleanup') {
            steps {
                sh '''
                    docker rm -f mojprojekt-test-container || true
                    docker rm -f mojprojekt-deploy-container || true
                '''
            }
        }

        stage('Build BLDR') {
            steps {
                sh '''
                    docker build --no-cache -t mojprojekt-bldr:${BUILD_NUMBER} -f MZ422009/Sprawozdanie1/Dockerfile.bld MZ422009/Sprawozdanie1
                '''
            }
        }

        stage('Build TEST') {
            steps {
                sh '''
                    docker build --no-cache -t mojprojekt-test:${BUILD_NUMBER} -f MZ422009/Sprawozdanie1/Dockerfile.test MZ422009/Sprawozdanie1
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    docker rm -f mojprojekt-test-container || true
                    docker run --name mojprojekt-test-container mojprojekt-test:${BUILD_NUMBER}
                '''
            }
        }

        stage('Build Deploy Image') {
            steps {
                sh '''
                    docker build --no-cache -t zucho/express-app:${BUILD_NUMBER} -t zucho/express-app:latest -f MZ422009/Sprawozdanie2/Dockerfile MZ422009/Sprawozdanie2
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f mojprojekt-deploy-container || true
                    docker run -d --name mojprojekt-deploy-container -p 8080:8080 zucho/express-app:${BUILD_NUMBER}
                '''
            }
        }

        stage('Publish to DockerHub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push zucho/express-app:${BUILD_NUMBER}
                        docker push zucho/express-app:latest
                        docker logout
                    '''
                }
            }
        }

        stage('Publish Artifacts') {
            steps {
                sh '''
                    mkdir -p artifacts
                    echo zucho/express-app:${BUILD_NUMBER} > artifacts/deploy-image.txt
                    echo zucho/express-app:latest > artifacts/deploy-latest.txt
                    docker images > artifacts/docker-images.txt
                '''
                archiveArtifacts artifacts: 'artifacts/*', fingerprint: true
            }
        }
    }

    post {
        always {
            sh '''
                docker ps -a || true
                docker images || true
            '''
        }
        success {
            echo 'Pipeline wykonany poprawnie.'
        }
        failure {
            echo 'Pipeline zakonczony bledem.'
        }
    }
}
